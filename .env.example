# DATABASE_URL: Supabase transaction-mode pooler (app runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Supabase session-mode pooler (Prisma CLI / migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=4000

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

GYM_NAME="My Gym"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="owner@example.com"
SUPER_ADMIN_PASSWORD="change-me-please"
# Optional: exactly 4 digits. Enables PIN login alongside password login.
SUPER_ADMIN_PIN="1234"
